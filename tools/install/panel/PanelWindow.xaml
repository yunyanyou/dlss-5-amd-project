<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OptScalerNR.Launcher;assembly=OptiScalerPanel"
        Title="OptiScaler"
        Width="900" Height="620"
        MinWidth="900" MinHeight="620"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeInk}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource ThemeBorder}"
        BorderThickness="1">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 抄自 MainWindow.xaml：卡片 / 窗口按钮 -->
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5"
                      BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True">
                <Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5"
                      BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True">
                <Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFC50F1F"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- 顶栏：56px，与 MainWindow 同高 -->
    <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5A3C" Offset="0"/>
              <GradientStop Color="#E3122B" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Column="1" Text="OptiScaler" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="11,0,0,0"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Ellipse x:Name="StatusLed" Width="6" Height="6" Fill="{DynamicResource ThemeSuccess}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="TopStatus" Foreground="{DynamicResource ThemeMuted}" FontSize="11"
                     VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshBtn" Content="↻" Style="{StaticResource CaptionButton}" FontSize="15"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <ComboBox x:Name="ThemeCombo" Width="104" Height="28" Margin="6,0,6,0" FontSize="11.5"
                    Background="{DynamicResource ThemeSubtle}" Foreground="{DynamicResource ThemeInk}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MinBtn" Content="—" Style="{StaticResource CaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource CloseCaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底栏：44px，与 MainWindow 同构（LED + 状态 + 竖线 + 作者 + 硬件） -->
    <Border DockPanel.Dock="Bottom" Height="44" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="BottomLed" Width="6" Height="6" Fill="{DynamicResource ThemeSuccess}"
                 VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="BottomStatus" Grid.Column="1" Foreground="{DynamicResource ThemeMuted}"
                   FontSize="11" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
        <Border Grid.Column="1" Width="1" Height="14" Background="{DynamicResource ThemeBorder}"
                Margin="12,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="26,0,0,0">
          <TextBlock x:Name="HardwareInfo" Foreground="{DynamicResource ThemeMuted}" FontSize="11"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="AuthorLink" Grid.Column="3" Foreground="{DynamicResource ThemeMuted}" FontSize="11"
                   VerticalAlignment="Center" Text="TheAutomatic ↗" Cursor="Hand"/>
      </Grid>
    </Border>

    <!-- 主体：左列表 240 + 间距 + 右卡片，与 LibraryPage 同构 -->
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Surface}" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock Text="注入名" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="点击切换，重启游戏生效" Foreground="{DynamicResource ThemeMuted}"
                       FontSize="10.5" Margin="0,2,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LoaderList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="状态" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock x:Name="GameText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"/>
            <TextBlock x:Name="WikiText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="OptiText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="OptiBtn" Content="安装 / 更新 OptiPatcher" Style="{DynamicResource GhostButton}"
                      Height="28" Padding="10,0"/>
              <Button x:Name="LogBtn" Content="打开日志" Style="{DynamicResource GhostButton}"
                      Height="28" Padding="10,0" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="配置预设" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="存一份当前 ini，之后一键切回来（套用前会自动备份）"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,2,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="PresetCombo" Height="30" Background="{DynamicResource ThemeSubtle}"
                        Foreground="{DynamicResource ThemeInk}" BorderBrush="{DynamicResource ThemeBorder}"/>
              <Button x:Name="PresetApplyBtn" Content="套用" Grid.Column="1"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="8,0,0,0"/>
              <Button x:Name="PresetSaveBtn" Content="保存当前" Grid.Column="2"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="6,0,0,0"/>
              <Button x:Name="PresetDeleteBtn" Content="删除" Grid.Column="3"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="6,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Surface}" Padding="14">
          <StackPanel>
            <TextBlock Text="画面分享" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="把调好的 Mochizuki 外观发给别人，或粘贴别人的码直接换上"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,2,0,8"/>
            <WrapPanel>
              <Button x:Name="ExportBtn" Content="晒出我的画面" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0" Margin="0,0,8,0"/>
              <Button x:Name="ImportBtn" Content="换上同款画面" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0" Margin="0,0,8,0"/>
              <Button x:Name="FolderBtn" Content="打开目录" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0"/>
            </WrapPanel>
            <TextBox x:Name="CodeBox" Height="30" Margin="0,10,0,0"
                     Background="{DynamicResource ThemeSubtle}" Foreground="{DynamicResource ThemeInk}"
                     BorderBrush="{DynamicResource ThemeBorder}" Padding="8,4"
                     FontFamily="Consolas" FontSize="11"/>
            <TextBlock x:Name="ShareHint" Text="码会自动复制到剪贴板；粘贴整段聊天文字也能识别"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
