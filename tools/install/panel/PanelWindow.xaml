<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OptiScaler"
        Width="880" Height="600"
        MinWidth="880" MinHeight="600"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeInk}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        BorderBrush="{DynamicResource ThemeBorder}"
        BorderThickness="1">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <DockPanel>
    <!-- 顶栏：与 MainWindow 同构（自绘标题栏 + 标题 + 状态 + 窗口按钮） -->
    <Border DockPanel.Dock="Top" Height="52" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5A3C" Offset="0"/>
              <GradientStop Color="#E3122B" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="N" Foreground="White" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
        </Border>
        <TextBlock Grid.Column="1" Text="OptiScaler" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="10,0,0,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Ellipse x:Name="StatusLed" Width="6" Height="6" Fill="{DynamicResource ThemeSuccess}"
                   VerticalAlignment="Center" Margin="0,0,7,0"/>
          <TextBlock x:Name="TopStatus" Foreground="{DynamicResource ThemeMuted}" FontSize="11"
                     VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="MinBtn" Content="—" Style="{DynamicResource GhostButton}" Width="34" Height="30"
                  Padding="0" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseBtn" Content="✕" Style="{DynamicResource GhostButton}" Width="34" Height="30"
                  Padding="0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部状态栏 -->
    <Border DockPanel.Dock="Bottom" Height="40" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="BottomLed" Width="6" Height="6" Fill="{DynamicResource ThemeSuccess}"
                 VerticalAlignment="Center" Margin="0,0,7,0"/>
        <TextBlock x:Name="BottomStatus" Grid.Column="1" Foreground="{DynamicResource ThemeMuted}"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Foreground="{DynamicResource ThemeMuted}" FontSize="11"
                   VerticalAlignment="Center" Text="TheAutomatic ↗" Cursor="Hand" x:Name="AuthorLink"/>
      </Grid>
    </Border>

    <!-- 主体：左列表 240 + 间隙 + 右详情，与 MainWindow 的 LibraryPage 同构 -->
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock Text="注入名" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock Text="点击切换，重启游戏生效" Foreground="{DynamicResource ThemeMuted}"
                       FontSize="10.5" Margin="0,2,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LoaderList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="状态" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
            <TextBlock x:Name="GameText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"/>
            <TextBlock x:Name="WikiText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"/>
            <TextBlock x:Name="OptiText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" Margin="0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="OptiBtn" Content="安装 / 更新 OptiPatcher" Style="{DynamicResource GhostButton}"
                      Height="28" Padding="10,0"/>
              <Button x:Name="LogBtn" Content="打开日志" Style="{DynamicResource GhostButton}"
                      Height="28" Padding="10,0" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="配置预设" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock Text="存一份当前 ini，之后一键切回来（套用前会自动备份）"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,2,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="PresetCombo" Height="30" Background="{DynamicResource ThemeSubtle}"
                        Foreground="{DynamicResource ThemeInk}" BorderBrush="{DynamicResource ThemeBorder}"/>
              <Button x:Name="PresetApplyBtn" Content="套用" Grid.Column="1"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="8,0,0,0"/>
              <Button x:Name="PresetSaveBtn" Content="保存当前" Grid.Column="2"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="6,0,0,0"/>
              <Button x:Name="PresetDeleteBtn" Content="删除" Grid.Column="3"
                      Style="{DynamicResource GhostButton}" Height="30" Padding="10,0" Margin="6,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="14">
          <StackPanel>
            <TextBlock Text="画面分享" FontWeight="SemiBold" FontSize="12.5"/>
            <TextBlock Text="把调好的 Mochizuki 外观发给别人，或粘贴别人的码直接换上"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,2,0,8"/>
            <WrapPanel>
              <Button x:Name="ExportBtn" Content="晒出我的画面" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0" Margin="0,0,8,0"/>
              <Button x:Name="ImportBtn" Content="换上同款画面" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0" Margin="0,0,8,0"/>
              <Button x:Name="FolderBtn" Content="打开目录" Style="{DynamicResource GhostButton}"
                      Height="30" Padding="12,0"/>
            </WrapPanel>
            <TextBox x:Name="CodeBox" Height="30" Margin="0,10,0,0"
                     Background="{DynamicResource ThemeSubtle}" Foreground="{DynamicResource ThemeInk}"
                     BorderBrush="{DynamicResource ThemeBorder}" Padding="8,4"
                     FontFamily="Consolas" FontSize="11"/>
            <TextBlock x:Name="ShareHint" Text="码会自动复制到剪贴板；粘贴整段聊天文字也能识别"
                       Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
