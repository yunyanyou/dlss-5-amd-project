<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OptScalerNR.Launcher;assembly=OptiScalerPanel"
        Title="OptiScaler代理切换"
        Width="900" Height="620"
        MinWidth="900" MinHeight="620"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeInk}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource ThemeBorder}"
        BorderThickness="1">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Modern Dark ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
      <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ThemeBorder}" CornerRadius="4" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeMuted}"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ComboBox Toggle Button Template -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
      <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
          </Grid.ColumnDefinitions>
          <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeMuted}" Data="M 0 0 L 4 4 L 8 0 Z"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeMuted}"/>
          <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeInk}"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Dark ComboBox Style -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
              <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Slide">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border x:Name="DropDownBorder" Background="{DynamicResource ThemeSubtle}" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}" CornerRadius="6" Margin="0,4,0,4">
                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark ComboBoxItem Style -->
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="true">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LibraryFilter" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
    </Style>
    <Style x:Key="LibraryFilterItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
      <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Modern CheckBox -->
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Card Surface Style -->
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <!-- Status Pill RadioButton Style -->
    <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="Body">
              <Border x:Name="PillBorder" CornerRadius="15" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{DynamicResource ThemeSubtle}"/>
              <Border CornerRadius="15" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#10FFFFFF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <StackPanel x:Name="Label" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6">
                <Ellipse x:Name="Indicator" Width="6" Height="6" Fill="{DynamicResource ThemeMuted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"/>
              </StackPanel>
              <Border x:Name="KeyboardRing" Margin="-3" CornerRadius="18" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="true"><Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#202938"/>
                <Setter TargetName="PillBorder" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252D3E" Offset="0"/><GradientStop Color="#111725" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                <Setter TargetName="Indicator" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Label" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window Caption Buttons (Modern Fluent Integrated Chrome) -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GameContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource ThemeBorder}" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game List Item Style with Crimson Selection Accent -->
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" SnapsToDevicePixels="True"/>
              <Border x:Name="Accent" Background="{DynamicResource ThemeAccent}" Width="3" Height="22" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"/>
              <ContentPresenter Margin="9,7"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.08"/></Setter.Value></Setter>
                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- 顶栏：60px，与 MainWindow 同高 -->
    <Border DockPanel.Dock="Top" Height="60" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,9,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF4D4D" Offset="0"/>
                <GradientStop Color="#C40E1E" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="N" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="OptiScaler代理切换" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshBtn" Content="↻" Style="{DynamicResource GhostButton}" Width="32" Padding="0"
                  FontSize="18" Margin="0,0,5,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="ThemeToggle" Style="{DynamicResource GhostButton}" Width="36" Padding="0" Margin="0,0,5,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MinBtn" Content="—" Style="{StaticResource CaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxBtn" Content="▢" Style="{StaticResource CaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource CloseCaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底栏：44px，与 MainWindow 同构（LED + 状态 + 竖线 + 作者 + 硬件） -->
    <Border DockPanel.Dock="Bottom" Height="44" Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="QuickLogButton" Content="诊断日志" Style="{DynamicResource GhostButton}" BorderThickness="0"
                  Background="Transparent" Padding="9,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Height="26" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="BottomLed" Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{DynamicResource ThemeSuccess}" Margin="0,0,8,0"/>
            <TextBlock x:Name="BottomStatus" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}"
                       FontSize="11" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
            <Border Width="1" Height="14" Background="{DynamicResource ThemeBorder}" Margin="12,0"
                    VerticalAlignment="Center"/>
          </StackPanel>
          <DockPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource ThemeMuted}"
                       VerticalAlignment="Center">
              <Run x:Name="AuthorCaption"/>
              <Hyperlink x:Name="AuthorLink" NavigateUri="https://github.com/TheAutomatic/dlss-5-amd-project"
                         Cursor="Hand">
                <Hyperlink.Style>
                  <Style TargetType="Hyperlink">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                        <Setter Property="TextDecorations" Value="Underline"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Hyperlink.Style>
                TheAutomatic
              </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="HardwareInfo" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>

    <!-- 主体：左注入列表 240 + 间距 + 右内容（游戏卡 / 兼容修复 / ini 共享配置） -->
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Surface}" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock Text="注入代理" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="点击切换，立即生效" Foreground="{DynamicResource ThemeMuted}"
                       FontSize="10.5" Margin="0,2,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LoaderList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}">
        <StackPanel>
        <!-- 游戏卡：上游 HeroCard 的底子（深底 + 大图 + 渐变 + monogram），内容区自排：
             路径 → 大字游戏名 → 分组说明行（标签+内容）→ 底部横排按钮。文字多时向下扩展。 -->
        <Border x:Name="HeroCard" Background="#101522" CornerRadius="18" MinHeight="150" ClipToBounds="True" Margin="0,0,0,12">
          <Grid>
            <TextBlock x:Name="HeroMonogram" Text="N" FontSize="190" FontWeight="Black" Foreground="#26394C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-50,40,-50"/>
            <!-- 背景用 ImageBrush 而不是 Image 控件：画刷不参与布局测量，图片怎么放大都撑不高卡片 -->
            <Border><Border.Background><ImageBrush x:Name="HeroBgBrush" Stretch="UniformToFill" Opacity="0.75"/></Border.Background></Border>
            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2101522" Offset="0"/><GradientStop Color="#B0101522" Offset="0.55"/><GradientStop Color="#50101522" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Border><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#C0101522" Offset="0"/><GradientStop Color="#00101522" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <StackPanel Margin="20,16" VerticalAlignment="Center">
              <TextBlock x:Name="HeroKicker" Foreground="#9BA8BA" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="HeroTitle" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,4,0,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <StackPanel x:Name="HeroFacts"/>
            </StackPanel>
            <ProgressBar x:Name="HeroProgress" Height="3" VerticalAlignment="Bottom" Foreground="{DynamicResource ThemeAccent}" Background="#30405060" BorderThickness="0"/>
          </Grid>
        </Border>

        <!-- 兼容修复：结构与文案照抄上游“配置与运行库兼容诊断”区的 compat 部分 -->
        <Border Style="{StaticResource Surface}" Padding="15,12" Margin="0,12,0,12">
          <StackPanel>
            <TextBlock Text="配置与运行库兼容诊断" Foreground="{DynamicResource ThemeMuted}" FontSize="11.5" Margin="0,0,0,10"/>
            <TextBlock x:Name="CompatSummary" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,0,0,9"/>
            <WrapPanel Margin="0,0,0,4">
              <Button x:Name="CompatRepairBtn" Content="兼容修复" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" IsEnabled="False"/>
              <Button x:Name="CompatRestoreBtn" Content="恢复原文件" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" Margin="8,0,0,0" IsEnabled="False"/>
              <Button x:Name="CompatHelpBtn" Content="?" Style="{DynamicResource GhostButton}" Width="27" Height="27" Padding="0" Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
              <Button x:Name="OptiBtn" Content="安装 OptiPatcher（DLSS 伪装增强）" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" Padding="12,0"/>
              <Button x:Name="LogBtn" Content="打开日志" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" Padding="8,0" Margin="8,0,0,0"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ini 共享配置卡片：逐行照搬上游 MainWindow 的同名区块 -->
        <Border Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="IniFolderButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0"/>
                <Button x:Name="IniSaveButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="5,0,0,0"/>
                <Button x:Name="IniImportButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="5,0,0,0"/>
                <Button x:Name="IniApplyButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="12,0" Margin="5,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="IniHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="IniProfileCombo" Height="30"/>
              <TextBox x:Name="IniSearchBox" Grid.Column="1" Height="30" Margin="6,0,0,0" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeInk}" BorderBrush="{DynamicResource ThemeBorder}" Padding="8,5"/>
              <Button x:Name="IniRenameButton" Grid.Column="2" Style="{DynamicResource GhostButton}" Height="30" Padding="8,0" FontSize="10.5" Margin="6,0,0,0"/>
              <Button x:Name="IniDeleteButton" Grid.Column="3" Style="{DynamicResource GhostButton}" Height="30" Padding="8,0" FontSize="10.5" Margin="6,0,0,0"/>
            </Grid>
            <DockPanel Margin="0,8,0,0">
              <Button x:Name="IniQuickSaveButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="0,0,10,0"/>
              <TextBlock x:Name="IniSelectHint" Foreground="{DynamicResource ThemeMuted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <Border x:Name="StyleShareBar" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,10,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="StyleOutButton" Style="{DynamicResource GhostButton}" Height="30" FontSize="11.5" Padding="12,0" Margin="6,0,0,0"/>
                  <Button x:Name="StyleInButton" Style="{DynamicResource GhostButton}" Background="{DynamicResource ThemeAccent}" BorderThickness="0" Foreground="White" Height="30" FontSize="11.5" FontWeight="SemiBold" Padding="12,0" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="StyleShareTitle" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeInk}"/>
                  <TextBlock x:Name="StyleShareSub" FontSize="10" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock x:Name="IniProfileStatus" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
