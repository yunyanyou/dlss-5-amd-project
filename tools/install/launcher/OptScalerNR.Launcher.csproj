<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OptScalerNR.Launcher</RootNamespace>
    <AssemblyName>OptScalerNR.Launcher</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="MainWindow.cs"/>
    <Compile Include="Protocol.cs"/>
    <Compile Include="WorkerClient.cs"/>
    <Compile Include="GamePaths.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets"/>
</Project>
