<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OptScaler NR - 本软件免费，如付费购买请立即退款！"
        Width="1200" Height="780"
        MinWidth="1020" MinHeight="660"
        Background="#FF0C0D12"
        Foreground="#FFF3F4F6"
        FontFamily="Segoe UI, Microsoft YaHei UI, SimSun-ExtB, SimHei" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderBrush="#FF282D3A"
        BorderThickness="1"
        AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Modern Dark ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
      <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#FF282D3A" CornerRadius="4" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FF4A546E"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FFED1C24"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ComboBox Toggle Button Template -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
      <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
          </Grid.ColumnDefinitions>
          <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FF8E95A5" Data="M 0 0 L 4 4 L 8 0 Z"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="#FF3E465A"/>
          <Setter TargetName="Arrow" Property="Fill" Value="#FFF3F4F6"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="#FFED1C24"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Dark ComboBox Style -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="#FF161820"/>
      <Setter Property="BorderBrush" Value="#FF282D3A"/>
      <Setter Property="Foreground" Value="#FFF3F4F6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
              <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Slide">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border x:Name="DropDownBorder" Background="#FF161820" BorderThickness="1" BorderBrush="#FF282D3A" CornerRadius="6" Margin="0,4,0,4">
                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark ComboBoxItem Style -->
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Foreground" Value="#FFF3F4F6"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="true">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF222736"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF2A3144"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern CheckBox -->
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="#FFF3F4F6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#FF161820" BorderBrush="#FF282D3A" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stroke="#FFFFFFFF" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="Box" Property="Background" Value="#FFED1C24"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#FFED1C24"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FF4A546E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Card Surface Style -->
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="#FF14161F"/>
      <Setter Property="BorderBrush" Value="#FF232734"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- AMD Crimson Primary Button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#FFED1C24"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FFFF333B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FFC7141B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="Bd" Property="Background" Value="#FF252833"/>
                <Setter Property="Foreground" Value="#FF6E7585"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark Ghost Button -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#FF161820"/>
      <Setter Property="Foreground" Value="#FFF3F4F6"/>
      <Setter Property="BorderBrush" Value="#FF282D3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF222735"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3E465A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF14161E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="#FF6E7585"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1E212B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Status Pill RadioButton Style -->
    <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FFC5CBD8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Border x:Name="PillBorder" CornerRadius="15" Background="#FF161820" BorderBrush="#FF282D3A" BorderThickness="1" Padding="12,5" SnapsToDevicePixels="true">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Indicator" Width="7" Height="7" Fill="#FF6E7585" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FF4A546E"/>
                <Setter TargetName="PillBorder" Property="Background" Value="#FF1E222E"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FFED1C24"/>
                <Setter TargetName="PillBorder" Property="Background" Value="#FF241316"/>
                <Setter TargetName="Indicator" Property="Fill" Value="#FFED1C24"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window Caption Buttons (Modern Fluent Integrated Chrome) -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFC5CBD8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF1E222E"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF161820"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFC5CBD8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game List Item Style with Crimson Selection Accent -->
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFF3F4F6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent" CornerRadius="6" Padding="8,6" SnapsToDevicePixels="true">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF1E222E"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="#FF252C3D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFED1C24"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Modern Integrated Top App Bar -->
    <Border DockPanel.Dock="Top" BorderBrush="#FF1E222E" BorderThickness="0,0,0,1" Height="56" Background="#FF101218">
      <Grid Margin="18,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left Brand & Library Badge -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="6" Height="18" Background="#FFED1C24" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="PageTitle" Text="游戏库" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFFFF"/>
          <Border x:Name="CountBadgeBorder" Background="#FF1E222E" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="CountBadge" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#FF8E95A5"/>
          </Border>
          <Border Background="#2BFF9800" BorderBrush="#80FF9800" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="RefundWarning" Text="本软件免费，如付费购买请立即退款！" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFB74D"/>
          </Border>
        </StackPanel>

        <!-- Center Search Box -->
        <Border Grid.Column="1" Background="#FF161820" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="6" Height="34" Margin="20,0,20,0" MaxWidth="360" HorizontalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔍" FontSize="11" Foreground="#FF6E7585" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFF3F4F6" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
          </Grid>
        </Border>

        <!-- Quick Action Bar -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Button x:Name="AddButton" Content="+ 添加游戏" Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="LangToggle" Content="🌐 English" Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="SettingsTab" Content="设置" Style="{StaticResource GhostButton}" Height="30" Padding="12,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="LibraryTab" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Windows 11 Native Caption Buttons (Unified Window Frame) -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="&#x2014;" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#x25A2;" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseBtn" Style="{StaticResource CloseCaptionButton}" Content="&#x2715;" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Bottom Status Bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#FF1E222E" BorderThickness="0,1,0,0" Height="32" Background="#FF0C0D12">
      <DockPanel Margin="20,0">
        <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#FF8E95A5" Text="0 款游戏" FontSize="11"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusLed" Width="7" Height="7" Fill="#FF4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF8E95A5" Text="就绪" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content Workspace -->
    <Grid>
      <!-- Library View Page -->
      <Grid x:Name="LibraryPage" Margin="20,14,20,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Game List -->
        <Border Style="{StaticResource Surface}" Margin="0,0,14,0" Padding="10">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
              <TextBlock x:Name="LocalGamesHeading" Text="本地游戏" Foreground="#FF8E95A5" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
              <ComboBox x:Name="FilterCombo" DockPanel.Dock="Right" Width="105" Height="26" FontSize="11"/>
            </DockPanel>
            <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <!-- Keep the dark surface when installation disables game selection. -->
              <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                    <ScrollViewer x:Name="PART_ScrollViewer" Focusable="false" Padding="{TemplateBinding Padding}">
                      <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster Cover / Monogram Fallback -->
                    <Border Width="38" Height="50" CornerRadius="4" Background="#FF1E2330" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                      <Grid>
                        <!-- Stylized Initial Monogram -->
                        <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="#FFF3F4F6" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Cover Poster Image or Extracted Icon -->
                        <Image Source="{Binding DisplayImage}" Visibility="{Binding CoverVisibility}" Stretch="UniformToFill"/>
                      </Grid>
                    </Border>

                    <!-- Name and Source Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="#FFF3F4F6"/>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Background="#FF1E222E" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                          <TextBlock Text="{Binding SourceText}" FontSize="10" Foreground="#FF8E95A5"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>

                    <!-- Installation Dot / Status -->
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Foreground="{Binding StatusBrush}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Right Column: Game Details and Operations -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Hero Game Banner Card -->
            <Border Style="{StaticResource Surface}" Padding="20" MinHeight="180" ClipToBounds="True">
              <Grid>
                <!-- Hero Wallpaper Background (Faded vignette) -->
                <Image x:Name="HeroBgImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.18" Margin="-20,-20,-20,-20"/>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Large Cover Poster Preview -->
                  <Border Width="90" Height="120" CornerRadius="6" Background="#FF1E2330" BorderBrush="#FF282D3A" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid>
                      <TextBlock x:Name="HeroPosterInitial" Text="?" Foreground="#FF6E7585" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image x:Name="HeroPosterImage" Stretch="UniformToFill"/>
                    </Grid>
                  </Border>

                  <!-- Hero Content Details -->
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="HeroKicker" Text="已选游戏" Foreground="#FF8E95A5" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeroTitle" Text="选择一个游戏以开始" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#FFFFFFFF"/>
                    <TextBlock x:Name="HeroMeta" TextWrapping="Wrap" Text="选择游戏后自动检查运行状态与注入环境" Foreground="#FF8E95A5" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="HeroPath" Text="" Foreground="#FF6E7585" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>

                    <!-- Action Buttons Row -->
                    <WrapPanel Margin="0,4,0,0">
                      <Button x:Name="PrimaryButton" Content="⚡ 选择一个游戏" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="190" IsEnabled="False"/>
                      <Button x:Name="ChangeExeButton" Content="更换 EXE" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                      <Button x:Name="OpenFolderButton" Content="打开目录" Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
                      <Button x:Name="UninstallButton" Content="卸载" Style="{StaticResource GhostButton}" Margin="10,0,0,0" IsEnabled="False"/>
                    </WrapPanel>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" IsIndeterminate="False" Foreground="#FFED1C24" Background="#FF1E222E" BorderThickness="0"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- Configuration Section 1: DLL Injection Proxy -->
            <Border Style="{StaticResource Surface}" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="ProxyHeading" Text="注入代理 (Proxy DLL)" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                  <!-- Hidden legacy ComboBox for protocol compatibility -->
                  <ComboBox x:Name="ProxyCombo" Visibility="Collapsed" Width="0" Height="0"/>
                </DockPanel>

                <TextBlock x:Name="InjectText" TextWrapping="Wrap" Foreground="#FF8E95A5" FontSize="12" Margin="0,0,0,10"
                           Text="请从下方选择游戏启动时所加载的拦截代理 DLL："/>

                <!-- Horizontal Interactive Status Pills -->
                <WrapPanel x:Name="ProxyPillPanel">
                  <RadioButton x:Name="PillDxgi" Content="dxgi.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillD3d12" Content="d3d12.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWinmm" Content="winmm.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWinhttp" Content="winhttp.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWininet" Content="wininet.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillDbghelp" Content="dbghelp.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                </WrapPanel>

                <!-- Recommendation Banner -->
                <Border x:Name="InjectBanner" Background="#FF181D28" BorderBrush="#FF283042" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                  <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" x:Name="InjectIcon" Text="ℹ" Foreground="#FF4ADE80" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InjectRecommendation" TextWrapping="Wrap" Text="选择游戏后将分析 PE 导入表并自动匹配推荐代理。" Foreground="#FFCAD0DC" FontSize="12" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Configuration Section 2: Three Backend Engines -->
            <Border Style="{StaticResource Surface}" Padding="18" Margin="0,12,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="BackendsHeading" Text="后端加速管线 (Backend Engines)" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                  <!-- Hidden legacy ComboBox for protocol compatibility -->
                  <ComboBox x:Name="ActiveCombo" Visibility="Collapsed" Width="0" Height="0"/>
                </DockPanel>
                <TextBlock x:Name="BackendPackagePath" TextWrapping="Wrap" Foreground="#FF8E95A5" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- 1. mochi Backend Card -->
                <Border Background="#FF181C26" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <CheckBox x:Name="MochiCheck" Content="mochi · 0.0.6" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                      <Border x:Name="MochiBadge" DockPanel.Dock="Right" Background="#FF1E222E" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="MochiReason" Text="需权重" FontSize="11" Foreground="#FF8E95A5"/>
                      </Border>
                    </DockPanel>
                    <TextBlock x:Name="MochiDescription" TextWrapping="Wrap" Text="适合 RX 9000 系列" Foreground="#FF8E95A5" FontSize="11" Margin="26,4,0,6"/>
                    <DockPanel Margin="26,0,0,0">
                      <Button x:Name="MochiActiveBtn" Content="设为主后端" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Padding="10,0" HorizontalAlignment="Left"/>
                      <TextBlock x:Name="MochiActiveLabel" Text="★ 当前主后端" Foreground="#FFED1C24" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <TextBlock x:Name="MochiHint" TextWrapping="Wrap" Foreground="#FFB5BDCC" FontSize="11" Margin="26,8,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>

                <!-- 2. lmxxf Backend Card -->
                <Border Background="#FF181C26" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <CheckBox x:Name="LmxxfCheck" Content="lmxxf · 0.44" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                      <Border x:Name="LmxxfBadge" DockPanel.Dock="Right" Background="#FF17281F" BorderBrush="#FF22C55E" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="LmxxfReason" Text="就绪" FontSize="11" Foreground="#FF4ADE80"/>
                      </Border>
                    </DockPanel>
                    <TextBlock x:Name="LmxxfDescription" TextWrapping="Wrap" Text="适合 RX 9000 系列" Foreground="#FF8E95A5" FontSize="11" Margin="26,4,0,6"/>
                    <DockPanel Margin="26,0,0,0">
                      <Button x:Name="LmxxfActiveBtn" Content="设为主后端" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Padding="10,0" HorizontalAlignment="Left"/>
                      <TextBlock x:Name="LmxxfActiveLabel" Text="★ 当前主后端" Foreground="#FFED1C24" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <TextBlock x:Name="LmxxfHint" TextWrapping="Wrap" Foreground="#FFB5BDCC" FontSize="11" Margin="26,8,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>

                <!-- 3. Daniel Backend Card -->
                <Border Background="#FF181C26" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="6" Padding="14,10">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <CheckBox x:Name="DanielCheck" Content="Daniel · 0.3.0-0.6.0" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                      <Border x:Name="DanielBadge" DockPanel.Dock="Right" Background="#FF1E222E" BorderBrush="#FF282D3A" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="DanielReason" Text="检测中" FontSize="11" Foreground="#FF8E95A5"/>
                      </Border>
                    </DockPanel>
                    <TextBlock x:Name="DanielDescription" TextWrapping="Wrap" Text="适合 RX 6000/7000/9000 系列" Foreground="#FF8E95A5" FontSize="11" Margin="26,4,0,6"/>
                    <DockPanel Margin="26,0,0,0">
                      <Button x:Name="DanielActiveBtn" Content="设为主后端" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Padding="10,0" HorizontalAlignment="Left"/>
                      <TextBlock x:Name="DanielActiveLabel" Text="★ 当前主后端" Foreground="#FFED1C24" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                    </DockPanel>
                    <TextBlock x:Name="DanielHint" TextWrapping="Wrap" Foreground="#FFB5BDCC" FontSize="11" Margin="26,8,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Configuration Section 3: Preferences & Diagnostics -->
            <Border Style="{StaticResource Surface}" Padding="18" Margin="0,12,0,16">
              <StackPanel>
                <TextBlock x:Name="DiagnosticsHeading" Text="配置与诊断" FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFFFF" Margin="0,0,0,10"/>
                <CheckBox x:Name="ReplaceIni" IsChecked="True" Content="覆盖现有 OptiScaler.ini 配置文件 (推荐)" Margin="0,2,0,12"/>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="LogHeading" Text="运行诊断日志" Foreground="#FF8E95A5" FontSize="12" VerticalAlignment="Center"/>
                  <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="打开完整日志" Style="{StaticResource GhostButton}" Height="28" FontSize="11" Padding="10,0"/>
                </DockPanel>
                <TextBox x:Name="LogView" Height="100" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="#FF0C0D12" Foreground="#FF8E95A5" BorderBrush="#FF232734" BorderThickness="1" Padding="6" FontSize="11" FontFamily="Consolas, Segoe UI"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Settings Page -->
      <StackPanel x:Name="SettingsPage" Margin="28,24" Visibility="Collapsed">
        <TextBlock x:Name="SettingsHeading" Text="设置" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
        <TextBlock x:Name="LanguageHeading" Text="语言 / Language" Margin="0,18,0,6" Foreground="#FF8E95A5"/>
        <ComboBox x:Name="LangCombo" Width="160" Height="34" HorizontalAlignment="Left"/>
        <CheckBox x:Name="ScanOnStartup" Content="启动时自动扫描游戏库" IsChecked="True" Margin="0,16,0,0"/>
        <TextBlock x:Name="PackageHeading" Text="安装包目录（源码调试时选择完整解压包）" Margin="0,20,0,6" Foreground="#FF8E95A5"/>
        <DockPanel MaxWidth="600" HorizontalAlignment="Left">
          <Button x:Name="PackageBrowse" DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource GhostButton}" Width="96" Margin="8,0,0,0"/>
          <TextBox x:Name="PackageRootBox" Height="34" VerticalContentAlignment="Center" Background="#FF161820" Foreground="#FFF3F4F6" BorderBrush="#FF282D3A" Padding="8,0" Width="400"/>
        </DockPanel>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
