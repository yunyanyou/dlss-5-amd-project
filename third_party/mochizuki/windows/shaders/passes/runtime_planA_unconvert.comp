#version 460
// Plan A, output side: the network's answer in the session's canonical format back into the game's format.
//
// The readback is not format-agnostic: colourFootprint is built for the *game's* format, and both the
// vkCmdCopyImageToBuffer row pitch and the D3D12 CopyTextureRegion placed footprint come from it. So the answer
// is converted back here into colourImage, which is in the game's format; nothing downstream changes.
//
//   binding 0: the canonical image, sampled.
//   binding 1: the game's image, a storage image in PLAN_A_DST_FORMAT.
//
// PLAN_A_DST_FORMAT / PLAN_A_DST_MAX are substituted at compile time (see build_network.py): one module per
// destination format. PLAN_A_DST_MAX is the destination's largest finite value: 65024 for R11G11B10 (exponent
// 31 is reserved for Inf/NaN), 65504 for RGBA16F.
//
// Not a blit, for the same reason as the input side: R11G11B10 and RGBA16F are in different Vulkan format
// compatibility classes. Both images are in GENERAL layout; the caller transitions them and dispatches over the
// valid subrect only.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, PLAN_A_DST_FORMAT) uniform writeonly image2D dst;
layout(push_constant) uniform Push { uint width, height; } pc;

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    vec4 texel = texelFetch(src, xy, 0);
    // The network does not clamp its output, so a negative or non-finite value is possible. NaN -> 0 per
    // channel, then clamp to [0, the destination's max finite] (Inf -> max) instead of leaving it to the driver.
    texel = mix(texel, vec4(0.0), isnan(texel));
    texel = clamp(texel, vec4(0.0), vec4(PLAN_A_DST_MAX));
    imageStore(dst, xy, texel);
}
