#version 460
#if defined(NR_PACK_F16) || defined(NR_UNPACK_F16)
// Equal-extent nearest conversion; no tone mapping, clamp or UNORM quantization.
layout(local_size_x=8, local_size_y=8) in;
#ifdef NR_UNPACK_F16
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,rgba32f) uniform writeonly image2D result;
#else
layout(set=0,binding=0,rgba32f) uniform readonly image2D source;
layout(set=0,binding=1,rgba16f) uniform writeonly image2D result;
#endif
layout(push_constant) uniform Push { uint width, height; } pc;
void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    if (xy.x>=pc.width || xy.y>=pc.height) return;
#ifdef NR_UNPACK_F16
    imageStore(result,xy,texelFetch(source,xy,0));
#else
    imageStore(result,xy,imageLoad(source,xy));
#endif
}
#elif defined(NR_PACK_U8)
// Inline compute-family write-back for an R8G8B8A8_UNORM frame (runtime_pack_u8.spv).
// The format-converting blit is graphics-only. The answer already holds k/255 values
// (alpha pass, encode_u8), so this rounding equals the blit's float -> UNORM conversion.
// The bytes go to an R32_UINT image of the same 32-bit copy class; a copy places them.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,rgba32f) uniform readonly image2D answer;
layout(set=0,binding=1,r32ui) uniform writeonly uimage2D packed;
layout(push_constant) uniform Push { uint width, height; } pc;
void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    if (xy.x>=pc.width || xy.y>=pc.height) return;
    precise vec4 scaled=clamp(imageLoad(answer,xy),vec4(0),vec4(1))*255.0;
    precise vec4 shifted=scaled+0.5;
    uvec4 q=uvec4(floor(shifted));
    imageStore(packed,xy,uvec4(q.r | (q.g<<8) | (q.b<<16) | (q.a<<24),0u,0u,0u));
}
#else
// Preserve caller alpha. Float output keeps NR RGB; 8-bit output uses the same
// explicit rounding as the reference frame writer before the driver's format-converting blit.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0,rgba32f) uniform image2D result;
layout(set=0,binding=1) uniform sampler2D original;
layout(push_constant) uniform Push { uint width, height, encode_u8; } pc;
void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    if (xy.x>=pc.width || xy.y>=pc.height) return;
    vec3 rgb=imageLoad(result,xy).rgb;
    if(pc.encode_u8!=0u) {
        precise vec3 scaled=clamp(rgb,vec3(0),vec3(1))*255.0;
        precise vec3 shifted=scaled+0.5;
        rgb=floor(shifted)/255.0;
    }
    imageStore(result,xy,vec4(rgb,texelFetch(original,xy,0).a));
}
#endif
