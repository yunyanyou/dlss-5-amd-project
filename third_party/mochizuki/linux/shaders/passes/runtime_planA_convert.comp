#version 460
// Plan A, input side: a frame in a colour format other than the session's canonical (first-seen) one into the
// canonical format the network was built for. FF7 Rebirth flips R11G11B10 <-> RGBA16F at camera cuts; either
// can be the canonical one, so this module is built once per destination format.
//
// vkCmdBlitImage cannot do this: it only converts inside one Vulkan format compatibility class, and
// R11G11B10 (32 bpp) and R16G16B16A16_SFLOAT (64 bpp) are in different classes. An illegal blit recorded into
// the game's command list poisons it (Close() fails with E_INVALIDARG, the device is removed), so the
// conversion is a compute pass: the source is read through a sampler, the destination written as a storage
// image.
//
//   binding 0: the frame, sampled, in the game's format.
//   binding 1: the canonical image, a storage image in PLAN_A_DST_FORMAT.
//
// PLAN_A_DST_FORMAT / PLAN_A_DST_MAX are substituted at compile time (build_network.py): the storage image's
// format qualifier, and the destination's largest finite value (65024 for R11G11B10, whose exponent 31 is
// reserved for Inf/NaN; 65504 for RGBA16F).
//
// Both images are in GENERAL layout; the caller transitions them, dispatches over the valid subrect only and
// pads the rest afterwards.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, PLAN_A_DST_FORMAT) uniform writeonly image2D dst;
layout(push_constant) uniform Push { uint width, height; } pc;

void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    vec4 texel = texelFetch(src, xy, 0);
    // Storing a NaN, a negative or an out-of-range value into an unsigned float format is implementation-defined,
    // so sanitise first: NaN -> 0 per channel, then clamp to [0, the destination's max finite] (Inf -> max).
    texel = mix(texel, vec4(0.0), isnan(texel));
    texel = clamp(texel, vec4(0.0), vec4(PLAN_A_DST_MAX));
    imageStore(dst, xy, texel);
}
